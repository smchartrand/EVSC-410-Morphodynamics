    "from dataclasses import replace\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from teaching_model import Parameters, classroom_estimate, simulate_with_progress\n",
    "\n",
    "# Model parameters\n",
    "#------------------------------\n",
    "p = Parameters(\n",
    "    length_m=300,\n",
    "    dx_m=5,\n",
    "    width_m=8,\n",
    "    initial_slope=0.008,\n",
    "    discharge_m3s=8,\n",
    "    grain_m=0.025,\n",
    "    duration_s=1800,\n",
    "    max_dt_s=2,\n",
    "    save_count=7\n",
    ")\n",
    "\n",
    "# Output files are optional. Set True to save CSV tables and PNG figures.\n",
    "SAVE_OUTPUT = False\n"
   ]
}
