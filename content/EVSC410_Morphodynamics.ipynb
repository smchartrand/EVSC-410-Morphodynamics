   "source": [
    "from IPython.display import HTML, display\n",
    "from html import escape\n",
    "\n",
    "# One progress bar for the complete set of three simulations.\n",
    "feed_ratios = [0.7, 1.0, 1.3]\n",
    "progress_display = display(HTML('Preparing simulations...'), display_id=True)\n",
    "\n",
    "def show_progress(scenario_index, ratio, fraction, elapsed, steps):\n",
    "    overall = 100 * (scenario_index + fraction) / len(feed_ratios)\n",
    "    progress_display.update(HTML(\n",
    "        f'<div style=\"font-family:sans-serif;max-width:620px\">'\n",
    "        f'<strong>Running scenario {scenario_index+1} of {len(feed_ratios)}</strong> '\n",
    "        f'(sediment feed ratio {ratio:.1f})'\n",
    "        f'<div style=\"background:#ddd;border-radius:7px;height:19px;margin:8px 0;overflow:hidden\">'\n",
    "        f'<div style=\"background:#2879b9;width:{overall:.1f}%;height:100%\"></div></div>'\n",
    "        f'<span>{overall:.0f}% complete overall · {fraction*100:.0f}% of current run '\n",
    "        f'· model time {elapsed:.0f} s · {steps:,} steps</span></div>'\n",
    "    ))\n",
    "\n",
    "results = {}\n",
    "for i, ratio in enumerate(feed_ratios):\n",
    "    scenario = replace(p, feed_ratio=ratio)\n",
    "    info = classroom_estimate(scenario)\n",
    "    if info['caution']:\n",
    "        raise ValueError('Reduce run size before proceeding')\n",
    "    def update(fraction, elapsed, steps, i=i, ratio=ratio):\n",
    "        show_progress(i, ratio, fraction, elapsed, steps)\n",
    "    results[ratio] = await simulate_with_progress(scenario, progress=update)\n",
    "\n",
    "progress_display.update(HTML('<strong>All three simulations completed.</strong>'))\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "for ratio, r in results.items():\n",
    "    ax.plot(r['x_m'], r['bed_m'][-1] - r['bed_m'][0], label=f'feed / capacity = {ratio}')\n",
    "ax.set(xlabel='Distance downstream (m)', ylabel='Bed elevation change (m)', title='Bed adjustment')\n",
    "ax.legend(); ax.grid(alpha=.25)\n",
    "plt.show()\n",
    "for ratio, r in results.items():\n",
    "    print(f'{ratio:.1f}: steps={r[\"steps\"]}, storage={r[\"storage_change_m3\"]:.6g} m³, '\n",
    "          f'mass residual={r[\"mass_balance_error_m3\"]:.2e} m³')\n"
   ]
